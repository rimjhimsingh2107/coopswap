{
  "name": "CoopSwap",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspaces/coopswap",
  "shutdownAction": "stopCompose",
  "features": {
    // lets you build the app images / run the full compose stack from inside the codespace
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "DATABASE_URL": "postgres://coopswap:coopswap@postgres:5432/coopswap",
    "TEST_DATABASE_URL": "postgres://coopswap:coopswap@postgres:5432/coopswap_test",
    "REDIS_URL": "redis://redis:6379",
    "TEST_REDIS_URL": "redis://redis:6379/1",
    "SMTP_URL": "smtp://mailpit:1025",
    "SESSION_SECRET": "codespace-dev-secret-change-me-0123456789",
    "WEB_ORIGIN": "http://localhost:5173"
  },
  "forwardPorts": [5173, 4000, 8025],
  "portsAttributes": {
    "5173": { "label": "web", "onAutoForward": "openBrowser" },
    "4000": { "label": "api" },
    "8025": { "label": "mailpit" }
  },
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.18.0 --activate && pnpm install --frozen-lockfile && pnpm db:migrate",
  "customizations": {
    "vscode": {
      "extensions": ["dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "bradlc.vscode-tailwindcss", "vitest.explorer", "ms-playwright.playwright"]
    }
  },
  "hostRequirements": { "cpus": 4, "memory": "8gb" }
}
