# copy to apps/api/.env for local dev (pnpm dev). every variable is validated
# at boot in apps/api/src/config/env.ts
NODE_ENV=development
PORT=4000
METRICS_PORT=9464
DATABASE_URL=postgres://coopswap:coopswap@localhost:5440/coopswap
REDIS_URL=redis://localhost:6380
WEB_ORIGIN=http://localhost:5173
# at least 32 chars. signs csrf + file urls, salts analytics hashes
SESSION_SECRET=change-me-change-me-change-me-change-me
# mailpit from docker compose; remove to just log emails
SMTP_URL=smtp://localhost:1025
UNIVERSITY_DOMAINS=northeastern.edu,husky.neu.edu
# local = files under apps/api/.data, s3 = S3_BUCKET (+ S3_ENDPOINT for minio etc)
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
